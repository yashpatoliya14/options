# ============================================================================
#  OPTIONS IV ARBITRAGE ALGO — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in your credentials:
#      cp .env.example .env
# ============================================================================

# --- 1. Delta Exchange API Credentials (5:30 PM IST / 12:00 UTC Expiry) ----
# Create these under Delta Exchange (India / Global) -> API Keys.
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# USE_TESTNET=true -> Delta testnet | USE_TESTNET=false -> Live Delta Exchange
USE_TESTNET=false
DELTA_TESTNET_URL=https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# --- 2. CoinSwitch PRO API Credentials (1:30 PM IST / 08:00 UTC Expiry) -----
# Obtain API Key and Secret (Ed25519) from CoinSwitch PRO -> API Trading.
COINSWITCH_API_KEY=your_coinswitch_api_key_here
COINSWITCH_SECRET_KEY=your_coinswitch_secret_hex_here
COINSWITCH_BASE_URL=https://coinswitch.co
COINSWITCH_PRO_URL=https://api-trading.coinswitch.co

# --- 3. Telegram Bot Integration --------------------------------------------
# 1. Message @BotFather on Telegram to create a bot and get TELEGRAM_BOT_TOKEN
# 2. Message @userinfobot to get your numeric TELEGRAM_CHAT_ID
# 3. Type "options", "arb", or "balance" in Telegram to trigger scans!
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- 4. Strategy & Asset Settings ------------------------------------------
# Asset: BTC or ETH
UNDERLYING_ASSET=BTC
# USD to INR conversion rate for displaying amounts in INR
USD_INR_RATE=86.50
# Number of OTM strikes above and below ATM to compare
NUM_OTM_STRIKES=5

# --- 5. Fund Balance & Rebalance Alert Thresholds --------------------------
# If one exchange account holds this percentage more than the other,
# an urgent rebalance alert is pushed to Telegram. (Default: 25.0%)
FUND_IMBALANCE_THRESHOLD_PCT=25.0
# How frequently the background service checks balances (in minutes)
BALANCE_CHECK_INTERVAL_MINUTES=30

# Fallback simulated balances (used when API keys are blank or paper testing)
SIMULATED_DELTA_BALANCE_USD=1000.0
SIMULATED_COINSWITCH_BALANCE_USD=1000.0
