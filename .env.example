# ============================================================================
#  AUTOMATED GOLD TREND + GRID HEDGING TRADING BOT (DELTA EXCHANGE INDIA)
# ============================================================================

# --- 1. Delta Exchange India API ------------------------------------------
DELTA_API_KEY=your_delta_india_api_key_here
DELTA_API_SECRET=your_delta_india_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange
DELTA_WS_URL=wss://socket.india.delta.exchange

# --- 2. Trading Mode -------------------------------------------------------
# Modes: PAPER | LIVE | BACKTEST (Default: PAPER for safety)
TRADING_MODE=PAPER

# --- 3. Instruments -------------------------------------------------------
PRIMARY_INSTRUMENT=XAUTUSD
HEDGE_INSTRUMENT=PAXGUSD

# --- 4. Strategy Parameters (Lot / Contract Based) ------------------------
TIMEFRAME=4h
SUPERTREND_ATR_PERIOD=10
SUPERTREND_MULTIPLIER=3.0

# Main trade lot allocation: 100 lots total (50 initial entry + 5 grids of 10 lots each)
PRIMARY_TOTAL_LOTS=100
PRIMARY_INITIAL_LOTS=50
GRID_LOTS_PER_LEVEL=10
GRID_LEVELS=5
GRID_SPACING_PERCENT=0.5

# Hedge allocation: 10 lots per hedge
HEDGE_LOTS=10
HEDGE_TRIGGER_PERCENT=1.0
HEDGE_TAKE_PROFIT_PERCENT=1.0

LEVERAGE=10

# --- 5. Risk Management Limits (Lot Based) --------------------------------
MAX_PRIMARY_LOTS=200
MAX_HEDGE_LOTS=100
MAX_TOTAL_LOTS=300
MAX_OPEN_HEDGES=10
MAX_DAILY_LOSS_USD=150.0
MAX_DRAWDOWN_PERCENT=15.0

# --- 6. Database & Server -------------------------------------------------
DATABASE_PATH=data/trading-bot.db
DATABASE_BACKUP_DIR=data/backups
LOG_LEVEL=info
PORT=3000
