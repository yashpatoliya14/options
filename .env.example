# ============================================================================
#  OPTIONS IV ARBITRAGE ALGO — ENVIRONMENT CONFIGURATION
#  Copy this file to `.env` and fill in your credentials:
#      cp .env.example .env
# ============================================================================

# --- 1. Delta Exchange API Credentials (5:30 PM IST Expiry) -----------------
# Create under Delta Exchange -> API Keys
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# USE_TESTNET=false -> Live Production | USE_TESTNET=true -> Testnet
USE_TESTNET=false
DELTA_TESTNET_URL=https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# --- 2. CoinSwitch PRO API Credentials (1:30 PM IST Expiry) ----------------
# Create under CoinSwitch PRO -> API Trading (Ed25519)
COINSWITCH_API_KEY=your_coinswitch_api_key_here
COINSWITCH_SECRET_KEY=your_coinswitch_secret_hex_here
COINSWITCH_BASE_URL=https://coinswitch.co
COINSWITCH_PRO_URL=https://api-trading.coinswitch.co

# --- 3. Telegram Bot Integration --------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- 4. Global Lot Size & Asset (Single Variable for Sizing) ----------------
# Change this SINGLE variable to adjust trade size across both exchanges!
# Example: 0.05 BTC, 0.1 BTC, 0.5 BTC, 1.0 BTC
TRADE_LOT_BTC=0.05

# Underlying asset & currency conversion
UNDERLYING_ASSET=BTC
USD_INR_RATE=86.50
NUM_OTM_STRIKES=5

# --- 5. Fund Balance & Margin Monitoring ------------------------------------
# Threshold % to trigger transfer alert between exchanges
FUND_IMBALANCE_THRESHOLD_PCT=25.0
BALANCE_CHECK_INTERVAL_MINUTES=30
