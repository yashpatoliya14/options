# Delta Exchange credentials
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Safety: keep true for testnet; set false only for intentional production use
USE_TESTNET=true
DELTA_TESTNET_URL=https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# Position size: 1 lot = one contract per spread leg
TRADE_QTY=1

# Optional market overrides
UNDERLYING_ASSET=BTC
UNDERLYING_SYMBOL=BTCUSD

# Optional Telegram notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
