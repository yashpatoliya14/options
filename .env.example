# ============================================================================
# EXECUTION MODE
# ============================================================================
# DRY_RUN = uses real market data but only logs simulated trades (safe)
# LIVE    = places real orders on Delta Exchange (real money!)
MODE=DRY_RUN
TRADING_SYMBOL=BTCUSDT

# Set to true to use Delta Exchange testnet (testnet-api.delta.exchange)
USE_TESTNET=false

# ============================================================================
# DELTA EXCHANGE API CREDENTIALS
# ============================================================================
# Get your keys from: https://www.delta.exchange/app/api_management
# Ensure your API key has "Trading" permissions enabled
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# ============================================================================
# TELEGRAM BOT ALERTS
# ============================================================================
# 1. Talk to @BotFather on Telegram to create a bot and get the token
# 2. Send a message to your bot, then visit:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
#    to find your chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============================================================================
# STRATEGY PARAMETERS
# ============================================================================
OTM_PCT=0.10               # Sell options this far OTM (0.10 = 10%)
STOP_LOSS_PCT=0.30          # Close leg if premium rises by this % (0.30 = 30%)
CHECK_INTERVAL_SEC=60       # How often to check prices (seconds)
TRADE_FREQUENCY_DAYS=7      # New strangle every N days
CONTRACT_SIZE=1             # Number of contracts per leg

# ============================================================================
# RISK MANAGEMENT
# ============================================================================
# Set to 0 to disable. Values in USD.
DAILY_LOSS_LIMIT=0          # Stop trading if daily loss exceeds this
KILL_SWITCH_LOSS=0          # Emergency shutdown if total session loss exceeds this

# ============================================================================
# HEARTBEAT
# ============================================================================
HEARTBEAT_INTERVAL_HOURS=6  # Send "I'm alive" message every N hours
