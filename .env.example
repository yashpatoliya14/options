# ============================================================================
#  options_algo — environment configuration
#  Copy this file to `.env` and fill in your own values:
#      cp .env.example .env
#  NEVER commit your real .env — it holds API secrets.
# ============================================================================

# --- Delta Exchange API credentials -----------------------------------------
# Create these under Delta Exchange (India) -> API Keys. The key must be
# IP-whitelisted for the machine you run this on. Keep the secret private.
DELTA_API_KEY=your_delta_api_key_here
DELTA_API_SECRET=your_delta_api_secret_here

# --- Endpoint selection -----------------------------------------------------
# USE_TESTNET=true  -> all orders hit the Delta *testnet* (paper money). SAFE DEFAULT.
# USE_TESTNET=false -> orders hit PRODUCTION and trade REAL money. Only set false
#                      when you fully intend to trade live.
USE_TESTNET=true

# Base URLs (defaults shown; override only if Delta changes them).
DELTA_TESTNET_URL=https://cdn-ind.testnet.deltaex.org
DELTA_BASE_URL=https://api.india.delta.exchange

# --- Order placement gate ---------------------------------------------------
# PLACE_ORDERS=false -> DRY-RUN: stream data, compute + log decisions, send NO orders.
# PLACE_ORDERS=true  -> actually place orders on whatever endpoint USE_TESTNET selects.
# (Passing --place on the command line forces this on regardless of this value.)
PLACE_ORDERS=false

# --- Trade sizing / instrument ----------------------------------------------
# Contracts per leg (future + option). 1 BTC option contract = 0.001 BTC.
TRADE_QTY=1
# Underlying asset symbol for the option chain and the perpetual future.
UNDERLYING_ASSET=BTC
UNDERLYING_SYMBOL=BTCUSD

# --- Telegram live notifications (optional) ---------------------------------
# TELEGRAM_ENABLED=true and both fields set -> trade alerts are pushed to Telegram.
# Get a bot token from @BotFather; get your chat id from @userinfobot.
# Notifications are best-effort: failures never interrupt trading.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
