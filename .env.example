
# ============================================================
# Delta Exchange API Credentials
# ============================================================
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here
DELTA_BASE_URL=https://api.india.delta.exchange
USE_TESTNET=false

# ============================================================
# Telegram Notifications
# ============================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_ENABLED=true

# ============================================================
# Underlying Instrument
# ============================================================
UNDERLYING_SYMBOL=BTCUSD
UNDERLYING_ASSET=BTC
CONTRACT_VALUE_UNDERLYING=0.001

# ============================================================
# Trading Mode (backtest | paper | live)
# ============================================================
TRADING_MODE=paper

# ============================================================
# Supertrend Strategy Parameters
# ============================================================
TIMEFRAME=2h
SUPERTREND_ATR_PERIOD=16
SUPERTREND_MULTIPLIER=1.5

# Higher-timeframe filter (e.g. 1d = daily trend filter)
HTF_TIMEFRAME=1d

# ============================================================
# Option Selection
# ============================================================
STRIKE_SELECTION_METHOD=supertrend_otm
MIN_PREMIUM=250

# ============================================================
# Stop Loss Settings
# ============================================================
USE_UNDERLYING_SL=true
STOP_LOSS_PERCENT=20.0
TRAILING_BREAKEVEN_PCT=50.0

# ============================================================
# Risk / Position Sizing
# ============================================================
# Fixed lot size per trade (every trade uses exactly this many lots)
FIXED_LOT_SIZE=5
# Max daily loss before stopping trades (0 = disabled)
MAX_DAILY_LOSS=0.0
# Max simultaneous open positions
MAX_OPEN_POSITIONS=1
# Slippage as % of premium
SLIPPAGE_PCT=0.5
# Trading fee as % of notional value
FEE_PCT=0.01

# ============================================================
# Persistence
# ============================================================
SQLITE_PATH=state/bot_state.db

# ============================================================
# Backtest Settings
# ============================================================
BACKTEST_START_DATE=
BACKTEST_END_DATE=
BACKTEST_DATA_MODE=auto
